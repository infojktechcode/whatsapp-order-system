# WhatsApp Order System - Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit real credentials (.env is gitignored).
#
# RULE: only PUBLIC keys may use the VITE_ prefix — Vite inlines every
# VITE_* variable into the browser bundle. Secrets stay server-side.

# ---------------------------------------------------------------------------
# Supabase (frontend — exposed to the browser)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Server-side only. Set these as Supabase Edge Function secrets:
#   supabase secrets set MPESA_CONSUMER_KEY=... MPESA_PASSKEY=...
# NEVER prefix these with VITE_ and NEVER read them from src/.
# ---------------------------------------------------------------------------
MPESA_ENV=                 # sandbox | production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_CALLBACK_URL=
MPESA_CALLBACK_SECRET=

# WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# App
APP_URL=
